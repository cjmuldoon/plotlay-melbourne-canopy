table Streets
	lineageTag: 2121a0b4-ee8d-c9b5-2fbc-7bd5cdfa7767

	measure 'Street shade now m2' = SUM ( Streets[canopy_2025] )
		formatString: #,0
		lineageTag: 8ad4eb1b-720f-84e2-1431-4dd76aacb849

	measure 'Street lost by 2045 m2' = SUM ( Streets[lost_by_2045] )
		formatString: #,0
		lineageTag: 7e7c5598-7d5d-b894-e9b0-f7616629b828

	measure 'Street share lost by 2045' = DIVIDE ( SUM ( Streets[lost_by_2045] ), SUM ( Streets[canopy_2025] ) )
		formatString: 0.0%
		lineageTag: 399480e4-e2de-9ade-6f54-cf9d66760a7f

