	partition Streets = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("geometry/streets_wkt.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "seg_descr", "str_type", "centroid_lat", "centroid_lng", "canopy_2025", "canopy_2035", "canopy_2045", "canopy_2055", "canopy_2065", "lost_by_2045", "pct_lost_by_2045"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"seg_descr", type text}, {"str_type", type text}, {"centroid_lat", type number}, {"centroid_lng", type number}, {"canopy_2025", type number}, {"canopy_2035", type number}, {"canopy_2045", type number}, {"canopy_2055", type number}, {"canopy_2065", type number}, {"lost_by_2045", type number}, {"pct_lost_by_2045", type number}}, "en-AU"),
				    Named = Table.AddColumn(Typed, "street", each Text.Trim(List.First(Splitter.SplitTextByAnyDelimiter({" between ", " from ", " and ", ","})(Text.Replace([seg_descr], "Intersection of ", "")))), type text)
				in
				    Named

	annotation PBI_ResultType = Table

