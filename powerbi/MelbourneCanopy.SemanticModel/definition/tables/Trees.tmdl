table Trees
	lineageTag: 97ff0f9d-5822-90b7-68a3-c1c8a4f95c86

	measure 'Tree count' = COUNTROWS ( Trees )
		formatString: #,0
		lineageTag: ffecb5fc-8a49-f4ea-b3ae-de4bf6b3157e

	measure 'Tree shade ha' = DIVIDE ( SUM ( Trees[canopy_m2] ), 10000 )
		formatString: #,0.0
		lineageTag: b8867c7d-1c8f-7738-fd61-11934e1a7deb

	column com_id
		dataType: string
		lineageTag: 3e8b1d25-566d-441f-3c1f-4ff449a45638
		summarizeBy: none
		sourceColumn: com_id

		annotation SummarizationSetBy = Automatic

	column lat
		dataType: double
		lineageTag: 2c315d82-253c-5f96-adf5-cdf8ca7733d2
		summarizeBy: none
		sourceColumn: lat
		dataCategory: Latitude

		annotation SummarizationSetBy = Automatic

	column lng
		dataType: double
		lineageTag: 2174b604-3308-f23e-c801-13a2ab4a380f
		summarizeBy: none
		sourceColumn: lng
		dataCategory: Longitude

		annotation SummarizationSetBy = Automatic

	column common_name
		dataType: string
		lineageTag: 189c3d82-338c-8b61-e62b-f8c9fc690e54
		summarizeBy: none
		sourceColumn: common_name

		annotation SummarizationSetBy = Automatic

	column genus
		dataType: string
		lineageTag: 0263f467-7e40-2845-23ad-bc2b83806d7c
		summarizeBy: none
		sourceColumn: genus

		annotation SummarizationSetBy = Automatic

	column located_in
		dataType: string
		lineageTag: c9d71276-8d7f-3b54-dec5-991e40b5e053
		summarizeBy: none
		sourceColumn: located_in

		annotation SummarizationSetBy = Automatic

	column precinct
		dataType: string
		lineageTag: ad1acaf8-1ab4-5a5d-6846-94d93dd75627
		summarizeBy: none
		sourceColumn: precinct

		annotation SummarizationSetBy = Automatic

	column age_description
		dataType: string
		lineageTag: b09a51d9-c6a4-4dfe-d942-cb55b15c5b54
		summarizeBy: none
		sourceColumn: age_description

		annotation SummarizationSetBy = Automatic

	column ule_band
		dataType: string
		sortByColumn: band_order
		lineageTag: a24e6185-8fcb-e08f-91c1-ad4770b9cbcd
		summarizeBy: none
		sourceColumn: ule_band

		annotation SummarizationSetBy = Automatic

	column end_by
		dataType: int64
		formatString: 0
		lineageTag: b72b64d7-e780-628b-8c32-a644eb447aae
		summarizeBy: none
		sourceColumn: end_by

		annotation SummarizationSetBy = Automatic

	column canopy_m2
		dataType: double
		formatString: #,0.0
		lineageTag: be6adeff-2ab0-61ed-baa2-e6628ac464bf
		summarizeBy: none
		sourceColumn: canopy_m2

		annotation SummarizationSetBy = Automatic

	column band_order
		dataType: int64
		formatString: 0
		lineageTag: 05c59f23-5fcf-b1d2-cbf3-54596f8e000d
		summarizeBy: none
		sourceColumn: band_order

		annotation SummarizationSetBy = Automatic

	partition Trees = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("trees/trees.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"com_id", "lat", "lng", "common_name", "genus", "located_in", "precinct", "age_description", "ule_band", "end_by", "canopy_m2"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"com_id", type text}, {"lat", type number}, {"lng", type number}, {"common_name", type text}, {"genus", type text}, {"located_in", type text}, {"precinct", type text}, {"age_description", type text}, {"ule_band", type text}, {"end_by", Int64.Type}, {"canopy_m2", type number}}, "en-AU"),
				    Ordered = Table.AddColumn(Typed, "band_order", each List.PositionOf({"< 10 years", "11 - 20 years", "21 - 30 years", "31 - 40 years", "> 41 years", "Not assessed"}, [ule_band]), Int64.Type)
				in
				    Ordered

	annotation PBI_ResultType = Table
