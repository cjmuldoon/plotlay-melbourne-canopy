table Blocks
	lineageTag: 04c4f9f5-95c4-f21d-1de6-5eb07056c15a

	/// The decade the shade measures use: the one picked, or 2025 when none is
	measure 'Year shown' = SELECTEDVALUE ( Years[year], 2025 )
		formatString: 0
		lineageTag: 93e21a20-d489-807c-2c8b-48ad3e0c0168

	/// Council-tree shade standing in the year shown (each tree gone by the top of its useful life band), in hectares
	measure 'Shade ha' =
			VAR y = [Year shown]
			RETURN DIVIDE ( CALCULATE ( SUM ( BlockYears[canopy_m2] ), Years[year] = y ), 10000 )
		formatString: #,0.0
		lineageTag: be24edb5-a7e7-dd80-6b2b-06901ded3fe7

	/// Shade in 2025, from the 2021 canopy outlines
	measure 'Shade now ha' = DIVIDE ( SUM ( Blocks[canopy_2025] ), 10000 )
		formatString: #,0.0
		lineageTag: 86fd5df1-e55a-4e46-81ab-49bf3df342ad

	/// Shade on trees whose useful life ends by 2045
	measure 'Lost by 2045 ha' = DIVIDE ( SUM ( Blocks[lost_by_2045] ), 10000 )
		formatString: #,0.0
		lineageTag: 5018c6b7-7212-f83f-7d52-7a5489c14527

	/// As the formula column pct_lost_by_2045 in Plotlay
	measure 'Share lost by 2045' = DIVIDE ( SUM ( Blocks[lost_by_2045] ), SUM ( Blocks[canopy_2025] ) )
		formatString: 0.0%
		lineageTag: a6b4abf5-5007-46bd-5b6d-888edfe58425

	/// Council-tree shade over the block area, in the year shown
	measure 'Shade per m2 of block' =
			VAR y = [Year shown]
			RETURN DIVIDE ( CALCULATE ( SUM ( BlockYears[canopy_m2] ), Years[year] = y ), SUM ( Blocks[area_m2] ) )
		formatString: 0.0%
		lineageTag: 26c0f5a1-b19e-1539-bf07-c871a982c713

	measure 'Trees in the blocks' = SUM ( Blocks[trees] )
		formatString: #,0
		lineageTag: 333f960e-00a4-b942-317d-8a6ee0ec9bb8

	measure 'Trees ending by 2045' = SUM ( Blocks[trees_ending_by_2045] )
		formatString: #,0
		lineageTag: 8266ade9-e4c0-98de-1c32-94287f529717

